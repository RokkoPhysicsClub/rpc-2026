---
//注意書き用コンポーネント
import Exclamation from '../../public/img/exclamation.svg';
---

<div class="warn-wrapper">
  <Exclamation class="warn-icon" />
  <div class="warn-box">
    <slot />
  </div>
</div>

<style>
.warn-icon{
  height: 1rem;
  width: 1rem;
  margin-inline-end: 1rem;
  :nth-child(1) {
    fill: var(--warn);
  }
  :nth-child(2) {
    fill: var(--surface);
  }
}

.warn-wrapper{
  display: flex;
  align-items: center;
  padding: 1.1rem;
  margin-block: 1rem;
  background-color: var(--warn-container);
  border-radius: 10px;
}
</style>